{
	"name": "vskript",
	"displayName": "VSkript",
	"description": "Visual Skript",
	"author": {
		"name": "vhone",
		"email": "v_hone@naver.com",
		"url": "https://blog.naver.com/v_hone"
	},
	"version": "0.0.9",
	"engines": {
		"vscode": "^1.56.0"
	},
	"publisher": "Vhone",
	"repository": {
		"type": "git",
		"url": "https://github.com/vhone/vskript.git"
	},
	"icon": "img/cover.png",
	"categories": [],
	"activationEvents": [
		"onLanguage:vskript",
		"workspaceContains:**/*.sk"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "vskript",
				"aliases": [
					"skript",
					"sk"
				],
				"extensions": [
					".sk"
				]
			}
		],
		"grammars": [
			{
				"language": "vskript",
				"scopeName": "source.sk",
				"path": "./themes/vskript.tmLanguage.json"
			}
		],
		"themes": [
			{
				"label": "VSkript - Dark+",
				"uiTheme": "vs-dark",
				"path": "./themes/vskript_dark.json"
			},
			{
				"label": "VSkript - light+",
				"uiTheme": "vs",
				"path": "./themes/vskript_light.json"
			}
		],
		"configuration": {
			"title": "VSkript Configuration",
			"properties": {
				"vskript.language": {
					"type": "string",
					"default": "en",
					"enum": ["en", "ko"],
					"enumDescriptions": [
						"English descriptions will be shown by default.",
						"한국어 설명서 및 가이드를 최우선으로 출력합니다."
					],
					"description": "vskript 인텔리센스(자동완성, 호버)에 표시될 가이드의 기본 언어를 설정합니다."
				},
				"vskript.hoverContentMode": {
				"type": "string",
				"default": "description",
				"enum": ["description", "code"],
				"enumDescriptions": [
					"함수 상단 주석으로 작성된 가이드설명서(#>)를 우선 출력합니다.",
					"함수의 실제 내부 소스 코드 본문(구현부)을 통째로 팝업에 출력합니다."
				],
				"description": "마우스를 올렸을 때(Hover) 표시할 함수의 콘텐츠 제공 형식을 선택합니다."
				}
			}
		},
		"configurationDefaults": {
			"[vskript]": {
				"editor.semanticHighlighting.enabled": true
			}
		}
	},

	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./ && npm run copy-resources",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"publish": "vsce package",
		"copy-resources": "copyfiles -u 1 src/resource/**/* out/"
	},
	"devDependencies": {
		"@types/glob": "^7.1.3",
		"@types/mocha": "^8.0.4",
		"@types/node": "^12.20.55",
		"@types/vscode": "^1.120.0",
		"@typescript-eslint/eslint-plugin": "^4.14.1",
		"@typescript-eslint/parser": "^4.14.1",
		"copyfile": "^0.1.2",
		"copyfiles": "^2.4.1",
		"eslint": "^7.19.0",
		"glob": "^7.1.6",
		"mocha": "^8.2.1",
		"typescript": "^4.1.3",
		"vscode-test": "^1.5.0"
	},
	"dependencies": {
		"axios": "^1.16.1"
	}
}
