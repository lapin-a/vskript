{
	"name": "vskript",
	"displayName": "VSkript",
	"description": "Visual Skript",
	"author": {
		"name": "vhone",
		"email": "v_hone@naver.com",
		"url": "https://blog.naver.com/v_hone"
	},
	"version": "0.0.9",
	"engines": {
		"vscode": "^1.56.0"
	},
	"publisher": "Vhone",
	"repository": {
		"type": "git",
		"url": "https://github.com/vhone/vskript.git"
	},
	"icon": "img/cover.png",
	"categories": [],
	"activationEvents": [
		"onLanguage:vskript",
		"workspaceContains:**/*.sk"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "vskript",
				"aliases": [
					"skript",
					"sk"
				],
				"extensions": [
					".sk"
				]
			}
		],
		"grammars": [
			{
				"language": "vskript",
				"scopeName": "source.sk",
				"path": "themes/vskript.tmLanguage.json"
			}
		],
		"themes": [
			{
				"label": "VSkript (Light+)",
				"id": "vskript",
				"uiTheme": "vs",
				"path": "./themes/vskript_light.json"
			},
			{
				"label": "VSkript (Dark+)",
				"id": "vskript",
				"uiTheme": "vs-dark",
				"path": "./themes/vskript_dark.json"
			}
		],
		"semanticTokenTypes": [
			{
				"id": "templateType",
				"superType": "type",
				"description": "A templete type"
			}
		],
		"semanticTokenModifiers": [
			{
				"id": "native",
				"description": "test token modifiers"
			}
		],
		"configuration": {
            "title": "vSkript",
            "properties": {
                "vskript.analyze.indentation": {
                    "type": "boolean",
                    "default": true,
                    "description": "들여쓰기 오류(혼용 및 깊이)를 검사할지 여부를 설정합니다."
                },
                "vskript.analyze.preferSpaces": {
                    "type": "boolean",
                    "default": false,
                    "description": "체크 시 공백(Space)을, 체크 해제 시 탭(Tab)을 권장 들여쓰기로 사용합니다."
                }
            }
        },
		"configurationDefaults": {
			"[vskript]": {
				"editor.semanticHighlighting.enabled": true
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js",
		"publish": "vsce package"
	},
	"devDependencies": {
		"@types/glob": "^7.1.3",
		"@types/mocha": "^8.0.4",
		"@types/node": "^12.20.55",
		"@types/vscode": "^1.120.0",
		"@typescript-eslint/eslint-plugin": "^4.14.1",
		"@typescript-eslint/parser": "^4.14.1",
		"eslint": "^7.19.0",
		"glob": "^7.1.6",
		"mocha": "^8.2.1",
		"typescript": "^4.1.3",
		"vscode-test": "^1.5.0"
	}
}
